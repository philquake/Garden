<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the habit database and settings go to Google's backup and to a
     new phone during device-to-device transfer. Nothing else is backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
