<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center" android:weightSum="4">
        <FrameLayout android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp">
            <ImageView android:id="@+id/plant0" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/badge0" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="top|end" android:src="@drawable/widget_badge"
                android:visibility="gone" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp">
            <ImageView android:id="@+id/plant1" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/badge1" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="top|end" android:src="@drawable/widget_badge"
                android:visibility="gone" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp">
            <ImageView android:id="@+id/plant2" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/badge2" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="top|end" android:src="@drawable/widget_badge"
                android:visibility="gone" android:importantForAccessibility="no"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp">
            <ImageView android:id="@+id/plant3" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no"/>
            <ImageView android:id="@+id/badge3" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="top|end" android:src="@drawable/widget_badge"
                android:visibility="gone" android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="@string/widget_empty" android:textColor="#444444"
        android:visibility="gone"/>
    <ImageView android:id="@+id/prev" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_gravity="start|center_vertical" android:layout_marginStart="3dp" android:padding="2dp"
        android:background="@drawable/widget_nav_bg" android:src="@drawable/widget_chevron_left"
        android:contentDescription="@string/widget_prev" android:visibility="gone"/>
    <ImageView android:id="@+id/next" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_gravity="end|center_vertical" android:layout_marginEnd="3dp" android:padding="2dp"
        android:background="@drawable/widget_nav_bg" android:src="@drawable/widget_chevron_right"
        android:contentDescription="@string/widget_next" android:visibility="gone"/>
</FrameLayout>
